# Managed by chezmoi (source: dot_gitconfig.tmpl). Do not edit in place.
#
# No default identity on purpose. Identity comes from the includeIf blocks
# below, so a repo outside those directories has no user.name/user.email
# and must set them per repo:  git config user.name ...; git config user.email ...
# Override the directory list per host in ~/.config/chezmoi/chezmoi.toml:
#   [data]
#   git_personal_dirs = ["~/code/", "~/.local/share/chezmoi/"]
{{- $dirs := list "~/code/" "~/.local/share/chezmoi/" }}
{{- if hasKey . "git_personal_dirs" }}{{ $dirs = .git_personal_dirs }}{{ end }}
{{ range $dirs }}
[includeIf "gitdir:{{ . }}"]
	path = ~/.config/git/identity-personal
{{- end }}

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = store
{{- end }}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

#!/bin/sh
# Runs after `chezmoi apply` whenever ~/.proto/.prototools changed (hash below).
# Brings this host to the pins: proto itself first, then the tools. No-op if
# proto is not installed yet (bootstrap installs it and then does the same).
# prototools hash: {{ include "dot_proto/dot_prototools" | sha256sum }}
set -e
PROTO_HOME="${PROTO_HOME:-$HOME/.proto}"
PROTO="$PROTO_HOME/bin/proto"
if [ ! -x "$PROTO" ]; then
  echo "proto not installed; skipping (bootstrap does it)"
  exit 0
fi
pin="$(sed -n 's/^proto = "\(.*\)"/\1/p' "$PROTO_HOME/.prototools")"
have="$("$PROTO" --version | awk '{print $2}')"
if [ -n "$pin" ] && [ "$pin" != "$have" ]; then
  echo "==> proto $have -> $pin"
  "$PROTO" upgrade "$pin"
fi
echo "==> proto install --config-mode global"
"$PROTO" install --config-mode global -y
"$PROTO" regen --config-mode global
